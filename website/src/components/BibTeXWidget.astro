<div class="citation-widget relative min-w-0 max-w-full">
  <button
    type="button"
    class="absolute right-3 top-3 z-10 inline-flex items-center gap-1.5 rounded-md border border-stone-300 bg-white px-2.5 py-1.5 text-xs font-medium text-stone-700 shadow-sm transition-colors hover:bg-stone-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-700 disabled:cursor-wait"
    aria-label="Copy BibTeX citation"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <rect x="8" y="8" width="12" height="12" rx="2" />
      <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" />
    </svg>
    <span data-copy-label aria-live="polite">Copy</span>
  </button>
  <slot />
</div>

<script>
  document.querySelectorAll<HTMLElement>(".citation-widget").forEach((widget) => {
    const button = widget.querySelector<HTMLButtonElement>("button");
    const label = widget.querySelector<HTMLElement>("[data-copy-label]");
    const pre = widget.querySelector<HTMLPreElement>("pre");
    const code = pre?.querySelector("code");

    if (!button || !label || !pre || !code) return;

    pre.tabIndex = 0;
    pre.setAttribute("aria-label", "BibTeX citation");
    let resetTimer: number | undefined;

    button.addEventListener("click", async () => {
      window.clearTimeout(resetTimer);
      button.disabled = true;

      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        label.textContent = "Copied!";
        resetTimer = window.setTimeout(() => {
          label.textContent = "Copy";
        }, 2000);
      } catch {
        label.textContent = "Try again";
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .citation-widget {
    margin-block: 1.5em;
  }

  .citation-widget :global(pre) {
    max-width: 100%;
    margin: 0;
    overflow-x: auto;
    padding-top: 3.5rem;
  }

  .citation-widget :global(pre code) {
    white-space: pre;
  }

</style>
