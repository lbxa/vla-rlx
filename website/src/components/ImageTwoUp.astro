---
import type { ImageMetadata } from "astro";
import Image from "./Image.astro";

type ImageSource = string | ImageMetadata;

interface ImagePanel {
  src: ImageSource;
  alt: string;
  caption: string;
  thumbhash?: string;
  width?: number;
  height?: number;
  quality?: number;
}

interface Props {
  left: ImagePanel;
  right: ImagePanel;
  caption: string;
  class?: string;
}

const {
  left,
  right,
  caption,
  class: className,
} = Astro.props as Props;
---

<div class:list={["not-prose my-8", className]}>
  <div class="mx-auto grid w-full max-w-3xl grid-cols-2 gap-4 md:gap-6">
    <Image
      src={left.src}
      alt={left.alt}
      caption={left.caption}
      thumbhash={left.thumbhash}
      width={left.width}
      height={left.height}
      quality={left.quality}
      class="my-0"
    />
    <Image
      src={right.src}
      alt={right.alt}
      caption={right.caption}
      thumbhash={right.thumbhash}
      width={right.width}
      height={right.height}
      quality={right.quality}
      class="my-0"
    />
  </div>
  <p class="mt-4 text-center text-sm leading-relaxed text-stone-500">
    {caption}
  </p>
</div>
