---
import { getCollection, render } from "astro:content";
import Image from "../components/Image.astro";
import ImageTwoUp from "../components/ImageTwoUp.astro";
import "katex/dist/katex.min.css";
import "../styles/global.css";

const reportTitle = "Real-World Residual RL for Vision-Language Robotic Manipulation";
const reportType = "VLA-RLX Undergraduate Honours Thesis";
const reportDate = "Nov 28th, 2025";
const authors = ["Lucas Barbosa"];
const mdxComponents = { Image, ImageTwoUp };

const artifactUrls = {
  paper: "/files/thesis.pdf",
  code: "https://github.com/lbxa/vla-rlx",
  /** When set, Dataset becomes a link; otherwise a disabled pill. */
  dataset: "",
} as const;

const opensArtifactInNewTab = (href: string): boolean =>
  href.startsWith("http") || href.toLowerCase().endsWith(".pdf");

type ArtifactEntry = { label: string; href: string } | { label: string; muted: true };

const artifactButtons: ArtifactEntry[] = [
  { label: "Paper", href: artifactUrls.paper },
  { label: "Code", href: artifactUrls.code },
  ...(artifactUrls.dataset
    ? [{ label: "Dataset", href: artifactUrls.dataset }]
    : [{ label: "Dataset (coming soon)", muted: true as const }]),
  { label: "BibTeX", href: "#citation" },
];

const artifactPillClass =
  "inline-flex items-center justify-center rounded-full border border-stone-300 bg-white px-4 py-2 text-center text-xs font-medium text-stone-800 transition-colors";

const toSectionAnchor = (title: string): string =>
  title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const allSectionEntries = await getCollection("sections");
const abstractSectionEntry = allSectionEntries.find(
  (sectionEntry) =>
    sectionEntry.data.slug === "abstract" ||
    sectionEntry.id === "abstract" ||
    sectionEntry.id.endsWith("/abstract"),
);

if (!abstractSectionEntry) {
  throw new Error("Expected src/content/sections/abstract.mdx to exist.");
}

const sectionEntries = allSectionEntries
  .filter((sectionEntry) => sectionEntry !== abstractSectionEntry)
  .sort((firstSection, secondSection) => firstSection.data.order - secondSection.data.order);

const { Content: AbstractContent } = await render(abstractSectionEntry);
const abstractAnchorId = toSectionAnchor(abstractSectionEntry.data.slug ?? "abstract");

const renderedSections = await Promise.all(
  sectionEntries.map(async (sectionEntry) => {
    const { Content } = await render(sectionEntry);
    const anchorSource = sectionEntry.data.slug ?? sectionEntry.data.title ?? "";

    return {
      anchorId: toSectionAnchor(anchorSource),
      headingTitle: sectionEntry.data.title ?? "",
      Content,
    };
  }),
);

const tableOfContentsItems = renderedSections
  .filter(({ headingTitle }) => headingTitle.trim().length > 0)
  .map(({ anchorId, headingTitle }) => ({ anchorId, label: headingTitle }));
---

<html lang="en" class="bg-stone-50">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Residual reinforcement learning for adapting frozen VLA policies on a real SO-101 robot arm."
    />
    <meta name="generator" content={Astro.generator} />
    <title>{reportTitle}</title>
    <style is:global>
      html {
        scroll-behavior: smooth;
      }

      section[id] {
        scroll-margin-top: 2rem;
      }

      .prose blockquote {
        max-width: 40rem;
        margin: 1.75rem auto;
        border: none;
        /* typography plugin keeps padding-inline-start for the quote bar; reset for centered pull quotes */
        padding-inline: 0;
        background-color: transparent;
        text-align: center;
        font-style: normal;
      }

      .prose blockquote p {
        margin: 0;
        font-family: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Palatino, "Times New Roman", serif;
        font-size: 1.08rem;
        font-weight: 500;
        font-style: italic;
        letter-spacing: 0.01em;
      }
    </style>
  </head>
  <body class="bg-stone-50 text-stone-950">
    <main class="min-h-screen bg-stone-50">
      <section class="mb-12 pt-8 md:pt-12">
        <div class="mx-auto max-w-3xl px-1">
          <header class="mb-12 pt-20">
              <div class="mb-14 space-y-2 text-center text-xs">
                <svg
                  viewBox="0 0 22 12"
                  aria-hidden="true"
                  class="mx-auto mb-4 block h-3 w-auto text-sm leading-none text-stone-800"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M6 1.5C3.51 1.5 1.5 3.51 1.5 6C1.5 8.49 3.51 10.5 6 10.5C8.2 10.5 9.98 8.95 11 7C12.02 8.95 13.8 10.5 16 10.5C18.49 10.5 20.5 8.49 20.5 6C20.5 3.51 18.49 1.5 16 1.5C13.8 1.5 12.02 3.05 11 5C9.98 3.05 8.2 1.5 6 1.5Z"
                    stroke="currentColor"
                    stroke-width="1.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <p class="uppercase">{reportType}</p>
                <p>{reportDate}</p>
              </div>

              <hr class="mb-0 w-full border-t-4 border-stone-950" />
              <h1 class="py-10 text-center text-4xl font-light tracking-tight [text-wrap:balance]">
                {reportTitle}
              </h1>
              <hr class="w-full border-t-2 border-stone-950" />
              <p class="mt-12 text-center text-sm text-stone-600 md:mt-14">
                {
                  authors.map((author, authorIndex) => (
                    <>
                      {authorIndex > 0 ? ", " : null}
                      <span class="inline-flex flex-col items-center">
                        <span class="font-medium text-stone-900 underline underline-offset-4">{author}</span>
                        <span class="mt-1 text-stone-600">UNSW</span>
                      </span>
                    </>
                  ))
                }
              </p>

              <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
                {
                  artifactButtons.map((entry) =>
                    "href" in entry ? (
                      <a
                        href={entry.href}
                        target={opensArtifactInNewTab(entry.href) ? "_blank" : undefined}
                        rel={opensArtifactInNewTab(entry.href) ? "noopener noreferrer" : undefined}
                        class:list={[
                          artifactPillClass,
                          "hover:border-stone-950 hover:bg-stone-950 hover:text-white",
                        ]}
                      >
                        {entry.label}
                      </a>
                    ) : (
                      <span
                        aria-disabled="true"
                        class:list={[artifactPillClass, "cursor-default border-stone-200 bg-stone-100 text-stone-500"]}
                      >
                        {entry.label}
                      </span>
                    ),
                  )
                }
              </div>
          </header>
        </div>
      </section>

      <section class="pb-20">
        <div class="mx-auto max-w-3xl px-3 md:px-1">
          <div class="flex flex-col space-y-12">
            <section id={abstractAnchorId}>
              <div class="prose prose-stone mx-auto max-w-lg text-center text-sm leading-relaxed">
                <AbstractContent components={mdxComponents} />
              </div>
            </section>
            <nav class="mb-8 mt-4" aria-label="Table of Contents">
              <p class="mb-3 text-xs font-medium tracking-wide text-stone-500">&mdash; Table of Contents</p>
              <ul class="flex flex-col gap-1 pl-4">
                {
                  tableOfContentsItems.map(({ anchorId, label }) => (
                    <li>
                      <a
                        href={`#${anchorId}`}
                        class="inline-block text-sm text-stone-500 transition-colors hover:text-stone-700 focus-visible:text-stone-800 focus-visible:underline focus-visible:outline-none"
                      >
                        {label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
            {
              renderedSections.map(({ anchorId, headingTitle, Content }) => (
                <section id={anchorId}>
                  <h2 class="mb-4 text-4xl tracking-wide text-stone-900">{headingTitle}</h2>
                  <div class="prose prose-stone max-w-none">
                    <Content components={mdxComponents} />
                  </div>
                </section>
              ))
            }
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
